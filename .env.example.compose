# =====================================================================
# docker-compose environment file
# =====================================================================
# Copy to `.env` next to docker-compose.yml and edit values. Never commit .env.

# ----- Database -----
# Default: persistent SQLite file inside the api container's volume.
# For Postgres, run `docker compose --profile postgres up -d` and use:
#   DATABASE_URL=postgresql+psycopg://leads:CHANGE_ME@db:5432/leads
DATABASE_URL=sqlite:////app/data/leads.db

# ----- CORS -----
# Comma-separated list of origins allowed to call the API.
# In production, set this to the exact URL serving index.html (no trailing slash).
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ----- Admin token -----
# Required to access /api/admin/*. Open admin.html with ?token=<this>.
# Generate: `python -c "import secrets;print(secrets.token_urlsafe(40))"`
ADMIN_TOKEN=UnicvesityAdminToken123

# ----- Optional Postgres password -----
# Only used when running with `--profile postgres`.
DB_PASSWORD=please-change-me

# ----- API tuning -----
API_WORKERS=2

# ----- Frontend host port -----
FRONTEND_PORT=80
