# =====================================================
# Environment configuration for the Unicvesity backend
# =====================================================
# Copy to .env and fill in real values.
#
# Where the SQLite database file lives.
# Use sqlite:///./leads.db for a local file, or
# postgresql+psycopg://user:pass@host/dbname for Postgres in production.
DATABASE_URL=sqlite:///./leads.db

# Comma-separated list of origins allowed to call the API from a browser.
# Add your real domain(s) here when you deploy (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# Simple bearer token that protects the /api/admin/* endpoints.
# Open the page with:  /admin.html?token=YOUR_TOKEN
# Change this to a long random string before going to production.
ADMIN_TOKEN=UnicvesityAdminToken123
